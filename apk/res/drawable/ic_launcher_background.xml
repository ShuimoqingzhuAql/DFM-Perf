<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标背景：深石墨色对角渐变 #111827 -> #080D16（纯矢量，无位图） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path android:pathData="M0,0 H1024 V1024 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="140"
                android:startY="120"
                android:endX="900"
                android:endY="920">
                <item android:offset="0" android:color="#111827" />
                <item android:offset="0.55" android:color="#0D1420" />
                <item android:offset="1" android:color="#080D16" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
