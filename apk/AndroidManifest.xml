<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.dfmperf"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Android 11+ 包可见性：不声明这一项，getLaunchIntentForPackage 会返回 null -->
    <queries>
        <package android:name="com.tencent.tmgp.dfm" />
        <package android:name="com.proxima.dfm" />
        <package android:name="com.garena.game.df" />
    </queries>


    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="DFM 画质工坊"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="DFM 画质工坊">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置读取通道：游戏进程内的模块通过 ContentResolver 查询 -->
        <provider
            android:name=".SettingsProvider"
            android:authorities="io.github.dfmperf.settings"
            android:exported="true"
            android:enabled="true" />

        <!-- LSPosed / Xposed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="三角洲行动国服画质/帧率写入（LSPosed，无需 root；未加密，可逆向）" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
