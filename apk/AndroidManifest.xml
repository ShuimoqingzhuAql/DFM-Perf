<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.dfmperf"
    android:versionCode="18"
    android:versionName="2.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Android 11+ 包可见性：不声明这一项，getLaunchIntentForPackage 会返回 null -->
    <queries>
        <package android:name="com.tencent.tmgp.dfm" />
        <package android:name="com.proxima.dfm" />
        <package android:name="com.garena.game.df" />
    </queries>


    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="DFM 画质工坊"
        android:theme="@style/AppTheme">

        <!-- 真正的界面：不带 LAUNCHER，桌面图标由下面的 alias 提供，可运行时禁用；
             同时声明 Xposed 标准设置入口，LSPosed 模块页的「打开」靠它，隐藏图标后仍可进入 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="DFM 画质工坊">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面入口别名：隐藏图标 = 禁用这个组件；MainActivity 仍然可以 am start 打开 -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="DFM 画质工坊"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 设置读取通道：游戏进程内的模块通过 ContentResolver 查询 -->
        <provider
            android:name=".SettingsProvider"
            android:authorities="io.github.dfmperf.settings"
            android:exported="true"
            android:enabled="true" />

        <!-- LSPosed / Xposed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="三角洲行动国服画质/帧率写入（LSPosed，无需 root；未加密，可逆向）" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
